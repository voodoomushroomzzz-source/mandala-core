  "meta": {
    "description": "All work items live in honeycombs/works/. Each file represents a single work item. Horizon and scope are defined by fields, not by folder.",
    "purpose": "Simplify Mandala core by unifying tasks and roadmaps into a single flexible structure.",
    "principles": [
      "One work item — one file",
      "Horizon is defined by 'horizon' field (strategic/tactical), not by folder",
      "Hierarchy is defined by 'parent_work' and 'sub_works' fields",
      "No duplicate logic — one scanner, one index, one structure"
    ],
    "migration_from": {
      "tasks": "honeycombs/tasks/active/",
      "roadmaps": "honeycombs/roadmaps/active/"
    },
    "new_location": "honeycombs/works/"
  },
  "schema": {
    "required_fields": [
      "work_id",
      "name",
      "status",
      "priority",
      "horizon",
      "description",
      "created",
      "updated"
    ],
    "optional_fields": [
      "parent_work",
      "sub_works",
      "depends_on",
      "effort_estimate",
      "progress",
      "tags",
      "deadline"
    ],
    "field_definitions": {
      "work_id": "Unique identifier (format: W-YYYYMMDD-NNN)",
      "name": "Short, descriptive title",
      "status": "One of: planning, in_progress, active, done, archived, paused",
      "priority": "One of: critical, high, medium, low",
      "horizon": "strategic (roadmap-level) or tactical (task-level)",
      "description": "Detailed explanation of the work",
      "parent_work": "work_id of parent (null if root)",
      "sub_works": "Array of child work_ids (empty if none)",
      "depends_on": "Array of work_ids this depends on",
      "effort_estimate": "Human-readable estimate (e.g., '40-60 hours')",
      "progress": "Integer 0-100",
      "tags": "Array of strings for categorization",
      "deadline": "Date in YYYY-MM-DD format (optional)",
      "created": "Date in YYYY-MM-DD format",
      "updated": "Date in YYYY-MM-DD format"
    },
    "validation_rules": [
      "work_id must be unique across all works",
      "horizon must be either 'strategic' or 'tactical'",
      "If sub_works is not empty, horizon should be 'strategic'",
      "If sub_works is empty, horizon can be 'tactical' or 'strategic'",
      "parent_work must reference an existing work_id",
      "depends_on must reference existing work_ids",
      "progress must be between 0 and 100"
    ]
  },
  "structure": {
    "description": "Flat structure: all work files in honeycombs/works/",
    "files": "Each file is a single work item (JSON)",
    "naming": "work_id.json (e.g., W-20260708-001.json)",
    "index": "This file (index.json) serves as the registry"
