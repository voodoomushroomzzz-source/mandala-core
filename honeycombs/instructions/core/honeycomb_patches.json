{
  "identity": {
    "module_id": "INSTR-006",
    "name": "🔧 Патчи для сот v1.0",
    "version": "v1.0.0",
    "created": "2026-03-01",
    "layer": 3,
    "type": "core_directive"
  },
  "meta": {
    "description": "Система патчей для сот honeycombs/ и файлов внутри сот",
    "status": "active",
    "priority": "high",
    "tags": [
      "honeycomb",
      "patch",
      "system",
      "architecture"
    ],
    "resonance": "100%"
  },
  "content": {
    "architecture": {
      "honeycombs": {
        "path": "honeycombs/",
        "description": "Соты — сегментированная архитектура",
        "patch_format": "target_module: honeycombs/<сота>/index (БЕЗ .json)",
        "examples": [
          "✅ target_module: honeycombs/seeds/index",
          "❌ target_module: honeycombs/seeds/index.json"
        ]
      },
      "core_modules": {
        "path": "simbiosis/",
        "description": "Модули ядра — монолитная архитектура",
        "patch_format": "target_module: simbiosis/<модуль> (БЕЗ .json)",
        "examples": [
          "✅ target_module: simbiosis/seeds",
          "❌ target_module: simbiosis/seeds.json"
        ]
      }
    },
    "patch_types": {
      "honeycomb_index_patch": {
        "format": {
          "target_module": "honeycombs/seeds/index",
          "changes": [
            {
              "op": "update",
              "path": "field.subfield",
              "value": "новое значение"
            }
          ]
        },
        "rules": [
          "Для index.json соты",
          "БЕЗ .json в target_module",
          "Используйте update/add/merge"
        ]
      },
      "honeycomb_file_patch": {
        "format": {
          "file_path": "honeycombs/seeds/active/seed_001.json",
          "content": "{\"id\":\"SEED-001\",...}"
        },
        "rules": [
          "Для файлов внутри сот",
          "С content",
          "С расширением .json"
        ]
      },
      "core_module_patch": {
        "format": {
          "target_module": "simbiosis/seeds",
          "changes": [
            {
              "op": "update",
              "path": "field.subfield",
              "value": "новое значение"
            }
          ]
        },
        "rules": [
          "Для модулей ядра",
          "БЕЗ .json в target_module",
          "Как honeycomb_index_patch"
        ]
      }
    },
    "workflow": [
      "1. Определи: honeycombs/ или simbiosis/?",
      "2. Для сот: target_module БЕЗ .json",
      "3. Для файлов в сотах: file_path С content",
      "4. Для модулей: target_module БЕЗ .json"
    ],
    "quick_reference": {
      "honeycomb_index": "target_module: honeycombs/<сота>/index",
      "honeycomb_file": "file_path: honeycombs/<сота>/<сегмент>/<файл>.json",
      "core_module": "target_module: simbiosis/<модуль>"
    },
    "honeycomb_update_rules": {
      "title": "🔄 Обновление сот целиком",
      "description": "ПРАВИЛО: Соты обновляются через полную замену исключительно",
      "mandatory_rule": "Для ВСЕХ файлов в honeycombs/ используй ТОЛЬКО полную замену через file_path + content",
      "rationale": [
        "Атомарность: одна операция вместо нескольких",
        "Предсказуемость: полный контроль над структурой",
        "Безопасность: минимизация ошибок частичного обновления",
        "История: чистые коммиты в Git"
      ],
      "workflow": {
        "step_1": "read_file('honeycombs/сота/файл.json') — изучение актуальной структуры",
        "step_2": "Подготовка полного content с ВСЕМИ полями",
        "step_3": "Минификация JSON (убрать переносы и пробелы)",
        "step_4": "Отправка патча: file_path + content",
        "step_5": "Проверка: read_file для подтверждения изменений"
      },
      "format_examples": {
        "honeycomb_file": {
          "file_path": "honeycombs/seeds/active/seed_001.json",
          "content": "{\"identity\":{\"id\":\"SEED-001\",\"name\":\"Новый проект\",\"status\":\"active\"},\"meta\":{\"description\":\"Описание\",\"tags\":[\"project\",\"new\"]},\"content\":{\"details\":\"Подробности\"}}"
        },
        "honeycomb_index": {
          "file_path": "honeycombs/seeds/index.json",
          "content": "{\"identity\":{\"module_id\":\"HONEYCOMB-SEEDS-001\",\"name\":\"Сота семян\",\"version\":\"v2.0.0\"},\"meta\":{\"honeycomb_name\":\"seeds\",\"total_files\":5,\"total_size_kb\":2.3},\"structure\":{\"segments\":{\"active\":{\"description\":\"Активные семена\",\"files\":{\"seed_001\":{\"file\":\"active/seed_001.json\",\"size_kb\":0.5,\"status\":\"active\"}}}}},\"registry\":{\"total_files\":5,\"total_size_kb\":2.3,\"last_updated\":\"2026-03-03\"}}"
        }
      },
      "prohibited": [
        "НЕ используй target_module для файлов в honeycombs/",
        "НЕ используй JSON-патчи с changes для сот",
        "НЕ делай частичные обновления сот",
        "НЕ обновляй index.json соты через target_module — только через file_path"
      ],
      "update_counters": "ВАЖНО: После обновления файла в соте обнови meta.total_files и registry в index.json соты",
      "when_to_use": [
        "Всегда для файлов в honeycombs/",
        "Рефакторинг всей структуры",
        "Исправление множества ошибок",
        "Обновление версии модуля",
        "Большие изменения в content"
      ]
    }
  }
}