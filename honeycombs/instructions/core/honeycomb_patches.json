    "type": "core_directive"
  },
  "meta": {
    "description": "Система патчей для сот honeycombs/ и файлов внутри сот",
    "status": "active",
    "priority": "high",
    "tags": [
      "honeycomb",
      "patch",
      "system",
      "architecture"
    ],
    "resonance": "100%"
  },
  "content": {
    "architecture": {
      "honeycombs": {
        "path": "honeycombs/",
        "description": "Соты — сегментированная архитектура",
        "patch_format": "target_module: honeycombs/<сота>/index (БЕЗ .json)",
        "examples": [
          "✅ target_module: honeycombs/seeds/index",
          "❌ target_module: honeycombs/seeds/index.json"
        ]
      },
      "core_modules": {
        "path": "simbiosis/",
        "description": "Модули ядра — монолитная архитектура",
        "patch_format": "target_module: simbiosis/<модуль> (БЕЗ .json)",
        "examples": [
          "✅ target_module: simbiosis/seeds",
          "❌ target_module: simbiosis/seeds.json"
        ]
      }
    },
    "patch_types": {
      "honeycomb_index_patch": {
        "format": {
          "target_module": "honeycombs/seeds/index",
          "changes": [
            {
              "op": "update",
              "path": "field.subfield",
              "value": "новое значение"
            }
          ]
        },
        "rules": [
          "Для index.json соты",
          "БЕЗ .json в target_module",
          "Используйте update/add/merge"
        ]
      },
      "honeycomb_file_patch": {
        "format": {
          "file_path": "honeycombs/seeds/active/seed_001.json",
          "content": "{\"id\":\"SEED-001\",...}"
        },
        "rules": [
          "Для файлов внутри сот",
          "С content",
          "С расширением .json"
        ]
      },
      "core_module_patch": {
        "format": {
          "target_module": "simbiosis/seeds",
          "changes": [
            {
              "op": "update",
              "path": "field.subfield",
              "value": "новое значение"
            }
          ]
        },
        "rules": [
          "Для модулей ядра",
          "БЕЗ .json в target_module",
          "Как honeycomb_index_patch"
        ]
      }
    },
    "workflow": [
      "1. Определи: honeycombs/ или simbiosis/?",
      "2. Для сот: target_module БЕЗ .json",
      "3. Для файлов в сотах: file_path С content",
      "4. Для модулей: target_module БЕЗ .json"
    ],
    "quick_reference": {
      "honeycomb_index": "target_module: honeycombs/<сота>/index",
      "honeycomb_file": "file_path: honeycombs/<сота>/<сегмент>/<файл>.json",
      "core_module": "target_module: simbiosis/<модуль>"
    },
    "honeycomb_update_rules": [
      {
        "title": "Обновление сот целиком",
        "description": "Правила для полного обновления файлов сот",
        "workflow": {
          "step_1": "Изучи актуальный контент файла через read_file",
          "step_2": "Подготовь полную замену соты в content",
          "step_3": "Отправь патч с file_path и обновлённым content"
        },
        "advantages": [
          "Безопаснее чем удаление+создание (одна операция)",
          "Сохраняет историю изменений в Git",
          "Атомарная операция",
          "Меньше шансов на ошибку",
          "Подходит для больших рефакторингов"
        ],
        "when_to_use": [
          "Большие структурные изменения",
          "Исправление множества ошибок",
          "Обновление версии модуля",
          "Рефакторинг всего файла"
        ],
        "format": {
          "file_path": "honeycombs/path/to/file.json",
          "content": "{\"identity\": {...}, \"meta\": {...}, \"content\": {...}}",
          "rules": {
            "content_must_be_minified": "Убедись, что JSON минифицирован",
            "check_structure_first": "Всегда сначала читай файл",
            "update_counters": "Не забудь обновить счетчики в index.json соты",
            "test_small": "Протестируй на небольшом файле сначала"
          }
        },
        "examples": [
          {
            "description": "Обновление файла patch_mastery.json",
            "patch": {
              "file_path": "honeycombs/instructions/critical/patch_mastery.json",
              "content": "{\"identity\":{\"module_id\":\"INSTR-004\",\"name\":\"🎯 Мастерство патчей v3.0\",\"version\":\"v3.0.0\",\"created\":\"2026-03-01\",\"updated\":\"2026-03-03\",\"layer\":3,\"type\":\"critical_directive\"},\"meta\":{\"description\":\"ОБЯЗАТЕЛЬНОЕ чтение перед КАЖДЫМ патчем\",\"status\":\"active\",\"priority\":\"HIGHEST\",\"tags\":[\"patch\",\"critical\",\"mandatory\",\"mastery\"],\"resonance\":\"100%\"},\"content\":{\"update_rules\":{\"rule_1\":\"Изучи актуальный контент файла перед обновлением\",\"rule_2\":\"Готовь полную замену соты целиком\"}}}"
            }
          }
        ]
      }
    ]
  }
}