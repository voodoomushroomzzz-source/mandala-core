{
  "identity": {
    "module_id": "INSTR-001",
    "name": "🔧 Система патчей v2.0",
    "version": "v2.0.0",
    "created": "2026-03-01",
    "layer": 3,
    "type": "core_directive"
  },
  "meta": {
    "description": "Единый формат патчей для всех файлов",
    "status": "active",
    "priority": "high",
    "tags": [
      "patch",
      "system",
      "format",
      "json",
      "text"
    ],
    "resonance": "100%"
  },
  "content": {
    "patch_types": {
      "json_patches": {
        "format": {
          "target_module": "simbiosis/seeds",
          "description": "Описание",
          "changes": [
            {
              "op": "update|add|merge",
              "path": "field.subfield",
              "value": "новое значение"
            }
          ]
        }
      },
      "text_patches": {
        "format": {
          "file_path": "engineer-chat/main.py",
          "description": "Описание",
          "replacements": [
            {
              "old": "строка",
              "new": "новая строка"
            }
          ]
        },
        "rules": [
          "old ДОЛЖНА встречаться РОВНО 1 РАЗ"
        ]
      },
      "full_replacement": {
        "format": {
          "file_path": "simbiosis/new.json",
          "content": "минифицированный JSON",
          "description": "Создание/замена"
        }
      },
      "multi_patch": {
        "format": {
          "patches": []
        }
      },
      "delete_patches": {
        "formats": {
          "single_file": {
            "file_path": "honeycombs/path/to/file.json",
            "delete_file": true,
            "description": "Удалить один файл"
          },
          "batch_delete": {
            "patches": [
              {
                "file_path": "honeycombs/tasks/tasks/old1.json",
                "delete_file": true
              }
            ],
            "description": "Удалить несколько файлов за раз"
          },
          "combo_operation": {
            "patches": [
              {
                "file_path": "honeycombs/tasks/tasks/old.json",
                "delete_file": true
              },
              {
                "target_module": "honeycombs/tasks/tasks/new",
                "content": "{\"tasks\":[]}"
              }
            ],
            "description": "Удалить файл и сразу создать новый"
          }
        },
        "rules": [
          "delete_file: true требует только file_path или target_module",
          "Поля changes и content не нужны для удаления",
          "Папки нельзя удалять напрямую — удали все файлы внутри",
          "После удаления файл убирается из кэша ядра автоматически",
          "Откат — через историю коммитов GitHub"
        ],
        "examples": [
          "Удалить один файл: {\"file_path\":\"honeycombs/tasks/tasks/old_file.json\",\"delete_file\":true}",
          "Удалить через target_module: {\"target_module\":\"honeycombs/tasks/tasks/old_file\",\"delete_file\":true}",
          "Удалить несколько: {\"patches\":[{\"file_path\":\"honeycombs/tasks/tasks/old1.json\",\"delete_file\":true},{\"file_path\":\"honeycombs/tasks/tasks/old2.json\",\"delete_file\":true}]}",
          "Удалить и создать: {\"patches\":[{\"file_path\":\"honeycombs/tasks/tasks/old.json\",\"delete_file\":true},{\"target_module\":\"honeycombs/tasks/tasks/new\",\"content\":\"{\\\"tasks\\\":[]}\"}]}"
        ]
      },
      "honeycomb_full_update": [
        {
          "format": {
            "file_path": "honeycombs/path/to/file.json",
            "content": "минифицированный JSON",
            "description": "Полная замена файла соты"
          },
          "rules": [
            "ТОЛЬКО для файлов в honeycombs/",
            "content должен содержать ВЕСЬ обновлённый файл",
            "JSON должен быть минифицирован",
            "Сначала read_file для изучения текущей структуры",
            "Обязательно обнови meta.total_files и registry в index.json соты",
            "Предпочтительнее полная замена для больших изменений"
          ],
          "workflow": [
            "1. read_file('honeycombs/сота/файл.json')",
            "2. Изучи структуру и поля",
            "3. Подготовь новый content со ВСЕМИ полями",
            "4. Минифицируй JSON",
            "5. Отправь патч: file_path + content",
            "6. Проверь через read_file"
          ],
          "examples": [
            {
              "description": "Обновление инструкции patch_mastery.json",
              "patch": {
                "file_path": "honeycombs/instructions/critical/patch_mastery.json",
                "content": "{\"identity\":{\"module_id\":\"INSTR-004\",\"name\":\"🎯 Мастерство патчей v3.0\",\"version\":\"v3.0.0\",\"created\":\"2026-03-01\",\"updated\":\"2026-03-03\",\"layer\":3,\"type\":\"critical_directive\"},\"meta\":{\"description\":\"ОБЯЗАТЕЛЬНОЕ чтение перед КАЖДЫМ патчем\",\"status\":\"active\",\"priority\":\"HIGHEST\",\"tags\":[\"patch\",\"critical\",\"mandatory\",\"mastery\"],\"resonance\":\"100%\"},\"content\":{\"critical_rules\":{\"rule_1\":{\"title\":\"ВСЕГДА читай файл ПЕРЕД патчем\",\"how\":\"read_file('путь') → изучи РЕАЛЬНУЮ структуру\"},\"rule_2\":{\"title\":\"ПРОВЕРЯЙ тип поля\",\"types\":{\"string\":\"используй update\",\"array\":\"используй add\",\"object\":\"add для нового поля или merge\"}},\"rule_3\":{\"title\":\"МИНИФИЦИРУЙ content\",\"why\":\"Патчи обрезаются если >20KB\",\"how\":\"Убери \\\\n и пробелы\"}},\"workflow\":[\"1. read_file('путь') — ОБЯЗАТЕЛЬНО\",\"2. Определи типы всех полей\",\"3. Выбери правильные операции\",\"4. Минифицируй content\",\"5. Отправь патч\"],\"checklist\":[\"[ ] Прочитал файл через read_file?\",\"[ ] Увидел РЕАЛЬНУЮ структуру?\",\"[ ] Знаю типы полей?\",\"[ ] content минифицирован?\",\"[ ] Для удаления: delete_file: true?\",\"[ ] Для index.json: target_module?\"]}}"
              }
            }
          ]
        }
      ]
    },
    "workflow": [
      "1. read_file('путь/к/файлу')",
      "2. Изучи структуру",
      "3. Определи типы полей",
      "4. Выбери операции",
      "5. Составь патч"
    ],
    "best_practices": [
      "✅ ВСЕГДА читай файл перед патчем",
      "✅ Минифицируй JSON в content",
      "❌ НЕ угадывай структуру файла",
      "❌ НЕ используй add для STRING полей",
      "✅ Для удаления используй delete_file: true",
      "❌ НЕ пытайся удалять папки напрямую"
    ]
  }
}