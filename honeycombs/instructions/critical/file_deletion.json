ри","4. Составь патч с delete_file: true","5. Отправь патч","6. Проверь результат через read_file"],"examples":{"delete_single":{"description":"Удалить один файл","patch":{"file_path":"honeycombs/tasks/tasks/old_file.json","delete_file":true}},"delete_via_target":{"description":"Удалить через target_module","patch":{"target_module":"honeycombs/tasks/tasks/old_file","delete_file":true}},"delete_multiple":{"description":"Удалить несколько файлов","patch":{"patches":[{"file_path":"honeycombs/tasks/tasks/old1.json","delete_file":true},{"file_path":"honeycombs/tasks/tasks/old2.json","delete_file":true},{"file_path":"honeycombs/tasks/meta/legacy.json","delete_file":true}]}},"delete_and_create":{"description":"Удалить файл и сразу создать новый","patch":{"patches":[{"file_path":"honeycombs/tasks/tasks/old.json","delete_file":true},{"target_module":"honeycombs/tasks/tasks/new","content":"{\"tasks\":[]}"}]}}}}