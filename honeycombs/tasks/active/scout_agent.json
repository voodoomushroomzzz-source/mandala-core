          "tokens_per_session": "3,000-6,000",
          "monthly_usage": "~40,000 токенов"
        },
        "decision": {
          "score_ge_70": "сохранить в honeycombs/seeds/",
          "score_lt_70": "удалить из raw/"
        },
        "cleanup": "удалить обработанные raw файлы"
      }
    },
    "tech_stack": {
