{
    "template_name": "Basic Task",
    "version": "2.0",
    "created_at": "2026-04-10",
    "description": "Template for creating tasks in Mandala Symbiosis. Tasks are concrete work units, completable within 1 month.",
    "fields": {
        "task_id": "T-XXX (from tasks/index.json registry)",
        "name": "[CATEGORY] Brief description [DEADLINE]",
        "status": "todo | in_progress | completed",
        "priority": "CRITICAL | HIGH | MEDIUM | LOW",
        "created": "YYYY-MM-DD",
        "updated": "YYYY-MM-DD",
        "description": "Detailed task description",
        "tags": ["tag1", "tag2"],
        "progress": 0,
        "notes": "Additional notes"
    },
    "title_conventions": {
        "format": "[CATEGORY] Description [DEADLINE]",
        "categories": ["Architecture", "Bot", "Chat", "Research", "Documentation", "Optimization", "Fix", "Feature"],
        "deadlines": ["YYYY-MM-DD", "ASAP", "WHEN", "No deadline"],
        "priority_in_description": "Optional: add [CRITICAL], [HIGH], [MEDIUM], [LOW] at start of description"
    },
    "example": {
        "task_id": "T-001",
        "name": "Translate Core to English",
        "status": "in_progress",
        "priority": "HIGH",
        "created": "2026-04-09",
        "updated": "2026-04-10",
        "description": "Translate all honeycomb JSON files from Russian to English. Preserve sacred terms.",
        "tags": ["translation", "english_core", "v3.0.0"],
        "progress": 86,
        "notes": "24/28 files translated. Next: flower_of_life.json"
    },
    "usage": "1. Copy this structure\n2. Fill in fields\n3. Save as active/task_XXX.json\n4. Update tasks/index.json registry"
}
