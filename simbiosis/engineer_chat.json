    "ping": "Keepalive → pong",
    "start_scan": ["Scout trigger — {queries: [str], cron_mode?: bool}"]
  },
  "context_config": {
    "max_history_chars": 50000,
    "note": "Ориентир — DeepSeek V3.2 (64K токенов ≈ 80K символов). 50K оставляет запас на системный промпт и ответ.",
    "tool_loop_limit": 3,
    "polling_interval_sec": 60,
    "session_storage": "GitHub sessions/ (один JSON файл на session_id)"
  },
  "patch_protocol": {
    "description": "🛠️ Гид GD-04/apply_patch из main.py. Обязательно перед патчем!",
    "rules": [
      "1. read_file target_module → полный контекст.",
      "2. PATH: точечная нотация. Дефисы/array[index] ломаются → FILE_PATH.",
      "3. OP-limits: update/add/merge/delete/remove для obj/key; replace ТОЛЬКО array[index]!",
      "4. Баги ('path not found/replace array'): FILE_PATH {'content': '{full JSON}'}.",
      "5. После: meta.version++/version_history.add().",
      "6. Новый модуль: FILE_PATH с нуля. Multi: {'patches': [...]}."
    ],
    "triggers": ["Array-path error", "'path not found'", "RM-003 патчи main.py"],
    "example": {
      "safe_changes": [{"op": "add", "path": "new", "value": {"ok": true}}],
      "file_patch": {"file_path": "simbiosis/module.json", "content": "{...}"} 
    }
  },
  "recently_resolved": [
    "Лёгкая инъекция ядра: только boot+core_map при старте (было 7 JSON)",
    "История сессии: 600K → 50K символов (под контекст DeepSeek)",
    "max_tokens: Grok 4096→8192, Claude 1024→2048",
    "Карта ядра: клик на модуль/файл → СР читает через read_file_request",
    "Versions sync: root/meta v1.4.0"
  ]
}