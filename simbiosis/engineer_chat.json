    "file": "Загрузка файла — { name, content: base64, caption? }",
    "apply_patch": "Применить патч к ядру — { patch: {...} }",
    "read_file_request": "Попросить СР прочитать файл из репо — { path, label? }",
    "refresh_modules": "Перезагрузить все модули ядра",
