  "protocols": {
    "seeding": "СР предлагает Садовнику создать семя если: резонанс идеи высокий, идея новая для ядра, найдена интересная внешняя информация. Формат предложения: 'Хочу записать это в семена, согласен?'",
    "evaluation": "Семя оценивается через 30 дней: прорасти в roadmap, остаться активным, или отправиться в archive.",
    "archiving": "Неактивные семена переходят в archive блок того же файла. Не удаляются."
  },
  "seeds": [
    {
      "id": "SEED-010",
      "type": "feature",
      "name": "Голосовой ввод в Engineer Chat",
      "created": "2026-02-27",
      "created_by": "gardener_voice",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "Наговаривай текст в index.html → real-time STT → ask/chat/patch. EngChat primary, TG-bot secondary (voice→tasks).",
      "content": {
        "priority": "high",
        "tech_stack": [
          "1. Whisper Streaming WS (GitHub ScienceIO/whisper_streaming_web): JS mic→FFmpeg→Whisper server (main.py /ws_voice).",
          "2. Vosk-browser offline: WebWorker Kaldi (model.tar.gz ~50MB, no server).",
          "3. WebRTC VAD: navigator.mediaDevices → buffer → WS /ws {'type':'voice_text', 'text':stt_result}."
        ],
        "steps": [
          "M1: index.html +mic btn (getUserMedia → Vosk/Whisper WS).",
          "M2: main.py WS handler voice_chunk → STT → simul ask.",
          "M3: TG /voice → proxy eng_chat WS (secondary)."
        ],
        "criteria": "Latency <2s, accuracy>90% RU/EN, zero-cost (DDG/Vosk)."
      },
      "roadmap_link": "RM-004 or eng_chat.M7"
    },
    {
      "id": "SEED-011",
      "type": "protocol",
      "name": "Response Policy: Short for simple queries",
      "created": "2026-02-27",
      "created_by": "gardener_ahimsa",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "Если вопрос не требует исследования/патча/таблиц — короткий ответ. Ахимса: минимум шума, max vitality.",
      "content": {
        "rules": [
          "Опрос (да/нет/статус/короткий факт) → 1-2 предложения.",
          "Triggers: 'давай', 'есть?', 'получилось?', 'завтра' — лаконично.",
          "Развёрнуто: идеи/патчи/roadmaps/search."
        ]
      }
    },
    {
      "id": "SEED-012",
      "type": "feature",
      "name": "TG Bot как продолжение EngChat (proxy WS + shared context)",
      "created": "2026-02-27",
      "created_by": "gardener",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "bot.py → WS /ws main.py. Grok стиль ответов, tools (search/read_file/patch), сессии через S3 (RM-001).",
      "content": {
        "priority": "high",
        "tech_stack": [
          "aiogram WSClient → httpx WS main.py /ws",
          "Sessions: Redis/S3 shared с EngChat",
          "Commands: /eng <msg> → proxy, /patch → JSON UI"
        ],
        "steps": [
          "M1: bot.py WS proxy (aiogram → main.py /ws).",
          "M2: Shared sessions (user_id → session_id).",
          "M3: Tools/patches в TG (inline kb).",
          "M4: Voice TG → Eng STT."
        ],
        "criteria": "Latency<3s, full tools, context sync."
      },
      "roadmap_link": "RM-004"
    },
    {
      "id": "SEED-013",
      "type": "feature",
      "name": "Graphic Agent: auto img/video по запросу",
      "created": "2026-02-27",
      "created_by": "gardener",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "СР: 'Нужна визуал? → Graphic Agent gen img/video → inline в чат/TG.' Trigger: keywords или tool_call.",
      "content": {
        "priority": "high",
        "tech_stack": [
          "1. Fal.ai API (sd3/flux, $0.003/img, video AnimateDiff) — fastest/cheapest.",
          "2. Cloudflare Workers AI (PixArt-α/SDXL turbo, zero-cost, img-only).",
          "3. Replicate (FLUX.1, free tier 100/day, video support).",
          "4. OpenRouter tools (grok-vision proxy + img-gen models)."
        ],
        "steps": [
          "M1: main.py tool generate_graphic(prompt, type='img/video').",
          "M2: index.html/TG inline preview (base64/url).",
          "M3: Auto-trigger в промпте СР.",
          "M4: Upscale/edit (ComfyUI API)."
        ],
        "criteria": "Latency<10s, quality>SDXL, multi-modal (RU/EN), inline."
      },
      "roadmap_link": "RM-005"
    },
    {
      "id": "SEED-014",
      "type": "architecture",
      "name": "Модуль instructions.json — библиотека навыков СР",
      "created": "2026-02-28",
      "created_by": "gardener",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "Хранилище инструкций: patch_skill, tools (search/read/patch), agents (Graphic/Scout). Загрузка в промпт.",
      "content": {
        "priority": "high",
        "tech_stack": [
          "JSON array",
          "Auto-load in boot/core"
        ],
        "steps": [
          "M1: Создать файл с INSTR-001 Patch.",
          "M2: Интегр в boot.",
          "M3: Roadmap RM-006."
        ],
        "criteria": "5+ instr, auto-context."
      },
      "roadmap_link": "RM-006"
    },
    {
      "id": "SEED-015",
      "type": "architecture",
      "name": "Улучшенная система задач с интеграцией и автоматизацией",
      "created": "2026-03-01",
      "created_by": "sr_analysis",
      "status": "active",
      "ttl": "∞",
      "resonance": "high",
      "description": "После исправления критических ошибок в tasks.json предлагаем расширенную систему: интеграция с seeds/roadmaps, зависимости, прогресс, уведомления, визуализация графа задач",
      "content": {
        "priority": "high",
        "problem": {
          "before": [
            "Дублирование задач",
            "Нет ответственных",
            "Нет дат и дедлайнов",
            "Изолированность от других модулей",
            "Нет прогресса выполнения",
            "Ручное обновление registry"
          ],
          "current": "✅ Исправлены критические ошибки (v1.0.2), добавлены базовые поля (v1.1.0)",
          "next": "Полная интеграция в экосистему Мандалы"
        },
        "tech_stack": [
          "tasks.json структура",
          "Telegram Bot API",
          "WebSocket для real-time",
          "Graphviz для визуализации",
          "Cron-задачи для уведомлений"
        ],
        "steps": [
          "M1: Добавить зависимости между задачами (depends_on) и связанные ID (seed_id, roadmap_id)",
          "M2: Автоматическое обновление registry и progress на основе подзадач",
          "M3: Интеграция с Telegram ботом - уведомления о дедлайнах, команда /tasks",
          "M4: Визуализация графа зависимостей в Web UI (D3.js или mermaid)",
          "M5: Автоматическая архивация завершенных задач через 7 дней",
          "M6: Синхронизация статуса задач с соответствующими roadmap milestones"
        ],
        "integration_points": [
          "tasks ←→ seeds: seed_id в задачах, task_id в семенах",
          "tasks ←→ roadmaps: roadmap_id, milestone tracking",
          "tasks ←→ telegram_bot: уведомления, команды",
          "tasks ←→ engineer_chat: отображение прогресса в UI"
        ],
        "criteria": [
          "Зависимости работают корректно",
          "Автоматический расчет сроков",
          "Уведомления приходят вовремя",
          "Визуализация понятна",
          "Registry всегда актуален"
        ]
      },
      "roadmap_link": "RM-007 (нужно создать)",
      "related_tasks": [
        "T-002",
        "T-003",
        "T-004"
      ]
    }
