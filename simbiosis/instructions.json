          "solution": "Минификация + поэтапное создание"
        },
        "limits": {
          "max_tokens": "16384 токенов для Grok",
          "theoretical_max": "~60KB текста",
          "practical_max_json": "30-40KB",
          "recommended": "<20KB на патч"
        },
        "techniques": {
          "minification": {
            "description": "Убрать лишние пробелы и переносы",
            "before": "{\\n  \\\"key\\\": \\\"value\\\"\\n}",
            "after": "{\\\"key\\\":\\\"value\\\"}",
            "savings": "60-70% размера",
            "how": "json.dumps(data, separators=(',',':'))"
          },
          "step_by_step": {
            "description": "Создавать большие модули поэтапно",
            "steps": [
              "1. Создать пустую структуру",
              "2. Добавить данные частями через add",
              "3. Повторить до заполнения"
            ],
            "example": {
              "step_1": "Создать модуль с tasks: []",
              "step_2": "Добавить 20 задач через add",
              "step_3": "Добавить ещё 20 задач",
              "step_4": "Повторить до заполнения"
            }
          },
          "use_references": {
            "description": "Для больших текстов использовать ссылки",
            "bad": "Хранить весь текст в JSON",
            "good": "Хранить только ID и ссылку на .md файл"
          },
          "split_modules": {
            "description": "Разбить один большой на несколько маленьких",
            "example": "tasks_active.json + tasks_archive.json"
          }
        },
        "checklist": [
          "[ ] JSON минифицирован (нет \\n)?",
          "[ ] Размер content <20KB?",
          "[ ] Если >20KB: разбит на части?",
          "[ ] Используются короткие ключи?",
          "[ ] Большие тексты в отдельных файлах?"
        ],
        "examples": {
          "minified_module": {
            "file_path": "simbiosis/tasks.json",
            "content": "{\"identity\":{\"module_id\":\"TASKS-001\",\"name\":\"Tasks\",\"v\":\"1.0\"},\"meta\":{\"status\":\"active\"},\"tasks\":[]}",
