      "description": "Единый формат патчей для всех файлов: JSON, Python, HTML",
      "content": {
        "version": "2.0",
        "patch_types": {
          "json_patches": {
            "description": "Точечные изменения в JSON модулях",
            "use_for": ["simbiosis/*.json"],
            "format": {
              "target_module": "simbiosis/seeds",
              "description": "Описание изменения",
              "changes": [
                {
                  "op": "update|add|delete|remove|replace|merge",
                  "path": "field.subfield",
                  "value": "новое значение"
                }
              ]
            },
            "operations": {
              "update": "Обновить существующее поле",
              "add": "Добавить в массив или создать новое поле",
              "delete": "Удалить поле",
              "remove": "Удалить из массива по id",
              "replace": "Заменить целый блок",
              "merge": "Слить объект с существующим"
            }
          },
          "text_patches": {
            "description": "Точечные замены в текстовых файлах",
            "use_for": [".py", ".html", ".md", ".txt"],
            "format": {
              "file_path": "engineer-chat/main.py",
              "description": "Описание изменения",
              "replacements": [
                {
                  "old": "строка для замены (ДОЛЖНА БЫТЬ УНИКАЛЬНОЙ)",
                  "new": "новая строка"
                }
              ]
            },
            "rules": [
              "Строка в 'old' ДОЛЖНА встречаться РОВНО 1 РАЗ",
              "Если 0 раз → ошибка 'не найдена'",
              "Если >1 раз → ошибка 'N вхождений'",
              "Используй достаточно контекста для уникальности"
            ]
          },
          "full_replacement": {
            "description": "Полная замена файла или создание нового",
            "use_for": "Создание модулей, замена >30% файла",
            "format": {
              "file_path": "simbiosis/new_module.json",
              "content": "полное содержимое (МИНИФИЦИРОВАННОЕ)",
              "description": "Создание/замена файла"
            },
            "warning": "Используй редко! Предпочитай точечные изменения"
          },
          "multi_patch": {
            "description": "Изменения в нескольких файлах одновременно",
            "format": {
              "patch_id": "update_core",
              "description": "Общее описание",
              "patches": [
                {
                  "target_module": "simbiosis/seeds",
                  "changes": []
                },
                {
                  "file_path": "engineer-chat/main.py",
                  "replacements": []
                }
              ]
            }
          }
        },
        "workflow": [
          "1. ВСЕГДА read_file('путь/к/файлу') ПЕРВЫМ ДЕЛОМ",
          "2. Изучи РЕАЛЬНУЮ структуру файла",
          "3. Определи типы полей (string/array/object)",
          "4. Выбери правильные операции",
          "5. Проверь что paths существуют",
          "6. Минифицируй content если >5KB",
          "7. Составь патч",
          "8. Отправь в формате ```json\\n{...}\\n```"
        ],
        "errors": {
          "invalid_json": "JSON syntax error → проверь кавычки и запятые",
          "missing_token": "GITHUB_TOKEN не настроен → попроси Садовника",
          "string_not_found": "old не найден → перечитай файл и скопируй точно",
          "multiple_matches": "old встречается >1 раз → добавь контекста",
          "merge_missing_field": "Поле не существует → сначала add, потом merge"
        },
        "examples": {
          "add_seed": {
            "target_module": "simbiosis/seeds",
            "description": "Добавить новое семя",
            "changes": [
              {
                "op": "add",
                "path": "seeds",
                "value": {
                  "id": "SEED-042",
                  "name": "Новое семя",
                  "status": "active"
                }
              }
            ]
          },
          "fix_typo": {
            "file_path": "engineer-chat/main.py",
            "description": "Исправить опечатку",
            "replacements": [
              {
                "old": "logger.info('Резонас вычислен')",
                "new": "logger.info('Резонанс вычислен')"
