      "id": "INSTR-001",
      "name": "🔧 Навык: Работа с патчами v2.0",
      "type": "core_skill",
      "status": "active",
      "ttl": "∞",
      "origin": "patch_skill.json (gardener upload 2026-02-28)",
      "resonance": "high",
      "description": "Полное руководство по json/text/full патчам файлов (simbiosis/*.json, .py, .html). Workflow/examples/errors.",
      "content": {
        "patch_id": "SKILL-PATCHES-001",
        "name": "🔧 Навык: Работа с патчами",
        "version": "2.0",
        "created": "2026-02-28",
        "status": "active",
        "description": "Полное руководство СР по применению патчей для модулей, Python-файлов, HTML и других текстовых файлов",
        "core_principles": [
          "Патчи — хирургические изменения без перезаписи всего файла",
          "Всегда читай файл через read_file перед составлением патча",
          "Проверяй что строка для замены встречается РОВНО 1 РАЗ",
          "Если сомневаешься — спроси Садовника"
        ],
        "patch_types": {
          "json_patches": {
            "description": "Точечные изменения в JSON-модулях (simbiosis/*.json)",
            "use_for": [
              "simbiosis/seeds",
              "simbiosis/roadmaps",
              "simbiosis/*.json"
            ],
            "fields": {
              "target_module": "путь без .json (simbiosis/seeds)",
              "description": "описание",
              "changes": "массив операций"
            },
            "operations": {
              "update": "Обновить поле по пути",
              "add": "Добавить в массив",
              "delete": "Удалить поле",
              "remove": "Удалить из массива по id",
              "replace": "Заменить блок",
              "merge": "Слить объект"
            },
            "example": {
              "target_module": "simbiosis/seeds",
              "description": "Добавить SEED-042",
              "changes": [
                {
                  "op": "add",
                  "path": "seeds",
                  "value": {
                    "id": "SEED-042",
                    "name": "Новое семя",
                    "status": "active"
                  }
                }
              ]
            }
          },
          "text_patches": {
            "description": "Точечные замены в .py/.html/.md",
            "use_for": [
              "engineer-chat/main.py",
              "engineer-chat/index.html"
            ],
            "fields": {
              "file_path": "полный путь",
              "description": "описание",
              "replacements": "массив {old, new}"
            },
            "rules": [
              "old ДОЛЖНА быть уникальной (1 вхождение)",
              "0 → 'не найдена'",
              "N>1 → 'найдено N'",
              "Используй контекст + \\n"
            ],
            "example_py": {
              "file_path": "engineer-chat/main.py",
              "replacements": [
                {
                  "old": "logger.info(f\"Грок отвечвет\")",
                  "new": "logger.info(f\"Грок отвечает\")"
                }
              ]
            },
            "good": {
              "old": "def calculate_resonance(text):\\n    return 0.5",
              "new": "def calculate_resonance(text):\\n    return 0.85"
            }
          },
          "full_replacement": {
            "description": "Полная замена файла (content)",
            "use_for": [
              "Создание новых simbiosis/*.json",
              "Редкий full-rewrite"
            ],
            "fields": {
              "file_path": "путь",
              "content": "полный текст/JSON как строка (escaped)",
              "description": "..."
            },
            "example": {
              "file_path": "simbiosis/tasks.json",
              "content": "{\"identity\":{\"name\":\"Tasks\"},\"tasks\":[]}",
              "description": "Создать tasks.json"
            }
          }
        },
        "workflow": [
          "1. read_file(path)",
          "2. Проанализируй структуру",
          "3. Составь минимальный патч (1-3 changes)",
          "4. Проверь уникальность old/new",
          "5. Отправь патч"
        ],
        "errors": {
          "invalid_json": "Экранируй content: \\\" + \\n",
          "not_unique": "Добавь больше контекста в old"
        }
      }
    },
